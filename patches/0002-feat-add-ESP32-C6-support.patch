+# ESPHome compile test: ESP32-C6 with ESP-IDF framework
+# Target hardware: ESP32-C6-DevKitC-1 (ESP32-C6-WROOM-1) + CC1101 868 MHz module
+#
+# GPIO5 is a strapping pin on the ESP32-C6, so the chip select moves to GPIO6
+# instead of the GPIO5 used by the generic ESP32 wiring.
+substitutions:
+  spi_clk: GPIO18
+  spi_mosi: GPIO23
+  spi_miso: GPIO19
+  spi_cs: GPIO6
+  gdo0_pin: GPIO3
+
+esphome:
+  name: test-esp32-c6-idf
+  friendly_name: Test ESP32-C6 IDF
+
+esp32:
+  board: esp32-c6-devkitc-1
+  framework:
+    type: esp-idf
+
+logger:
+  level: DEBUG
+
+wifi:
+  ssid: "test-network"
+  password: ""
+
+external_components:
+  - source:
+      type: local
+      path: ../components
+
+spi:
+  clk_pin: ${spi_clk}
+  mosi_pin: ${spi_mosi}
+  miso_pin: ${spi_miso}
+
+# MQTT broker (required for elero_mqtt)
+mqtt:
+  broker: 192.168.1.100
+
+# Elero hub (no YAML covers/lights — devices managed via MQTT)
+elero:
+  cs_pin: ${spi_cs}
+  gdo0_pin: ${gdo0_pin}
+
+# MQTT adapter with NVS persistence
+elero_mqtt:
+  topic_prefix: elero
+  discovery_prefix: homeassistant
+  device_name: "Elero Gateway"
+
+# Web UI for RF discovery and device management
+elero_web:
+  port: 80
