+    EXPECT_EQ(cfg.supports_tilt, 1);
+    EXPECT_EQ(cfg.open_duration_ms, 25000u);
+    EXPECT_EQ(cfg.close_duration_ms, 24000u);
+    EXPECT_EQ(cfg.updated_at, 1234u);
